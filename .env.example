# Copy to .env and change values locally. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# memory uses brute-force cosine in process. postgres uses pgvector.
VECTOR_BACKEND=memory
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=cpu
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages: 
EMBEDDING_PASSAGE_PREFIX=

CHUNK_TARGET_TOKENS=480
CHUNK_OVERLAP_TOKENS=72
CHUNK_STRATEGY=structure
# model uses the embedding tokenizer when weights are available. regex is offline.
CHUNK_TOKENIZER=regex

RETRIEVAL_CANDIDATES=30
RERANK_TOP_N=8
CONTEXT_TOKEN_BUDGET=3000
RRF_K=60
BM25_K1=1.5
BM25_B=0.75

# Turn on after BAAI/bge-reranker-base can be loaded.
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu

LLM_PROVIDER=openai_compatible
# Used by `uv run` on the host. Compose ignores this name and uses
# COMPOSE_LLM_BASE_URL so localhost is not the API container.
LLM_BASE_URL=http://localhost:11434/v1
# Compose talks to the ollama service on the Compose network.
# Set this to http://host.docker.internal:11434/v1 only if Ollama runs on the host instead.
COMPOSE_LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=120

# Used only when LLM_PROVIDER=transformers. Leave empty until you choose a local model.
TRANSFORMERS_MODEL=
TRANSFORMERS_DEVICE=cpu
TRANSFORMERS_DTYPE=float32

INTEL_ENTITIES=false
INTEL_SECTION_CLASSIFIER=false
INTEL_DOCUMENT_CLASSIFIER=false
INTEL_SUMMARIZE=false

MAX_UPLOAD_BYTES=20971520
DATA_DIR=data

API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
